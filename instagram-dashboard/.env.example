# ============================================================
# Configuracion del Instagram Insights Dashboard
# ============================================================
# Copia este archivo a ".env" y completa tus valores reales.
# Si dejas estos valores vacios, la app arranca en MODO DEMO
# (datos de ejemplo) para que puedas verla funcionar sin setup.
# ------------------------------------------------------------

# Token de acceso de larga duracion de la Instagram Graph API.
# Se obtiene desde Meta for Developers (ver README, paso a paso).
IG_ACCESS_TOKEN=

# ID de tu cuenta de Instagram Business/Creator (NO es tu @usuario).
# Se obtiene con la Graph API (ver README).
IG_USER_ID=

# Version de la Graph API a usar (opcional).
GRAPH_API_VERSION=v21.0

# Puerto donde corre el servidor local (opcional).
PORT=3000
